---
import { getCollection } from 'astro:content';
import AnimatedSection from '../AnimatedSection.astro';

const skills = await getCollection('skills');
const sortedSkills = skills.sort((a, b) => a.data.order - b.data.order);
---

<section id="skills" class="section-padding bg-accent-50 dark:bg-primary-900/50">
  <div class="container-narrow">
    <AnimatedSection>
      <h2 class="heading-lg text-primary-800 dark:text-primary-100 mb-12">Skills</h2>
    </AnimatedSection>

    <div class="grid md:grid-cols-2 gap-6">
      {sortedSkills.map((skill, index) => (
        <AnimatedSection key={skill.id} delay={index * 0.1}>
          <div class="card">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-primary-200 dark:bg-primary-800 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-primary-600 dark:text-primary-400">
                  {skill.data.icon === 'code' && (
                    <polyline points="16 18 22 12 16 6"></polyline>
                  )}
                  {skill.data.icon === 'layout' && (
                    <>
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="3" y1="9" x2="21" y2="9"></line>
                      <line x1="9" y1="21" x2="9" y2="9"></line>
                    </>
                  )}
                  {!skill.data.icon && (
                    <circle cx="12" cy="12" r="10"></circle>
                  )}
                </svg>
              </div>
              <h3 class="heading-sm text-primary-800 dark:text-primary-100">
                {skill.data.category}
              </h3>
            </div>
            
            <div class="flex flex-wrap gap-2">
              {skill.data.items.map((item) => (
                <span class="px-3 py-1.5 text-sm bg-accent-200/50 dark:bg-accent-800/50 text-accent-700 dark:text-accent-300 rounded-lg">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </AnimatedSection>
      ))}
    </div>
  </div>
</section>
