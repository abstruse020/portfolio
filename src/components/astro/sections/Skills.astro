---
import { getCollection } from 'astro:content';
import AnimatedSection from '../AnimatedSection.astro';

const skills = await getCollection('skills');
const sortedSkills = skills.sort((a, b) => a.data.order - b.data.order);
---

<section id="skills" class="section-padding bg-accent-50 dark:bg-primary-900/50">
  <div class="container-narrow">
    <AnimatedSection>
      <h2 class="heading-lg text-primary-800 dark:text-primary-100 mb-12">Skills</h2>
    </AnimatedSection>

    <div class="grid md:grid-cols-2 gap-6">
      {sortedSkills.map((skill, index) => (
        <AnimatedSection key={skill.id} delay={index * 0.1}>
          <div class="card">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-primary-200 dark:bg-primary-800 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-primary-600 dark:text-primary-400">
                  {skill.data.icon === 'code' && (
                    <polyline points="16 18 22 12 16 6"></polyline>
                  )}
                  {skill.data.icon === 'chart' && (
                    <>
                      <line x1="18" y1="20" x2="18" y2="10"></line>
                      <line x1="12" y1="20" x2="12" y2="4"></line>
                      <line x1="6" y1="20" x2="6" y2="14"></line>
                    </>
                  )}
                  {skill.data.icon === 'brain' && (
                    <>
                      <path d="M12 2a5 5 0 0 1 5 5c0 1.1-.4 2.1-1 2.9.6.8 1 1.8 1 2.9a5 5 0 0 1-2 4v2.1a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2V12.8a5 5 0 0 1-2-4c0-1.1.4-2.1 1-2.9A5 5 0 0 1 7 7a5 5 0 0 1 5-5z"></path>
                    </>
                  )}
                  {skill.data.icon === 'server' && (
                    <>
                      <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                      <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                      <line x1="6" y1="6" x2="6.01" y2="6"></line>
                      <line x1="6" y1="18" x2="6.01" y2="18"></line>
                    </>
                  )}
                  {skill.data.icon === 'wrench' && (
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                  )}
                  {skill.data.icon === 'cloud' && (
                    <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
                  )}
                  {skill.data.icon === 'layout' && (
                    <>
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="3" y1="9" x2="21" y2="9"></line>
                      <line x1="9" y1="21" x2="9" y2="9"></line>
                    </>
                  )}
                  {!skill.data.icon && (
                    <circle cx="12" cy="12" r="10"></circle>
                  )}
                </svg>
              </div>
              <h3 class="heading-sm text-primary-800 dark:text-primary-100">
                {skill.data.category}
              </h3>
            </div>
            
            <div class="flex flex-wrap gap-2">
              {skill.data.items.map((item) => (
                <span class="px-3 py-1.5 text-sm bg-accent-200/50 dark:bg-accent-800/50 text-accent-700 dark:text-accent-300 rounded-lg">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </AnimatedSection>
      ))}
    </div>
  </div>
</section>
