---
import AnimatedSection from '../AnimatedSection.astro';
---

<section id="about" class="section-padding">
  <div class="container-wide">
    <AnimatedSection>
      <h2 class="heading-lg text-primary-800 dark:text-primary-100 mb-12">About</h2>
    </AnimatedSection>
    
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <AnimatedSection delay={0.1}>
        <div class="aspect-square rounded-2xl bg-primary-200 dark:bg-primary-800 overflow-hidden">
          <img 
            src={`${import.meta.env.BASE_URL}/images/profile.jpg`}
            alt="Profile" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </AnimatedSection>
      
      <AnimatedSection delay={0.2}>
        <div class="space-y-6">
          <p class="text-lg text-primary-700 dark:text-primary-300 leading-relaxed">
            Hello! I am a machine learning researcher passionate about neural networks who 
            enjoys working at the intersection of research and product. 
          </p>
          <p class="text-primary-600 dark:text-primary-400 leading-relaxed">
            I earned my M.S. (by Research) from the Indian Institute of Technology, Delhi. 
            I work on projects that push boundaries and solve real-world problems. When I'm not 
            working, you can find me running, swimming, or playing football or badminton.
          </p>
        </div>
      </AnimatedSection>
    </div>
  </div>
</section>
