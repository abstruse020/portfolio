---
const navItems = [
  { name: 'About', href: '#about' },
  { name: 'Publications', href: '#publications' },
  { name: 'Projects', href: '#projects' },
  { name: 'Skills', href: '#skills' },
  { name: 'Life', href: '#life' },
  { name: 'Contact', href: '#contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-40 bg-primary-50/80 dark:bg-primary-950/80 backdrop-blur-sm">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
    <a href="/" class="text-lg font-medium text-primary-800 dark:text-primary-200 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
      Harsh Pandey
    </a>
    
    <ul class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-sm text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-100 transition-colors link-underline"
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>

    <button
      id="mobile-menu-button"
      class="md:hidden p-2 text-primary-600 dark:text-primary-400"
      aria-label="Toggle menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden bg-primary-50 dark:bg-primary-950 border-t border-primary-200 dark:border-primary-800">
    <ul class="px-6 py-4 space-y-3">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="block text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-100 transition-colors"
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  
  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Close menu when clicking a link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
